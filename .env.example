# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only Supabase administration. Never prefix this key with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only secret. Never prefix this variable with VITE_.
OPENAI_API_KEY=your-openai-project-api-key

# Server-only production email settings. Never prefix these with VITE_.
# RESEND_FROM_EMAIL must be an address on a domain already verified by Resend.
RESEND_API_KEY=your-resend-api-key
RESEND_WEBHOOK_SECRET=your-resend-webhook-signing-secret
RESEND_FROM_EMAIL=no-reply@callrabbitsfoot.com

# Optional server settings
OPENAI_ESTIMATE_MODEL=gpt-5.6-sol
OPENAI_OPERATIONS_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OWNER_HUB_ALLOWED_ORIGINS=https://your-owner-hub-domain.example

# Required when the Android bundle calls a separately hosted Owner Hub API.
VITE_OWNER_HUB_API_URL=https://your-owner-hub-domain.example
VITE_PUBLIC_PORTAL_URL=https://rabbits-foot-owner-hub.vercel.app

# Server-only Square settings. Add these in Vercel, never in the Android bundle.
SQUARE_ACCESS_TOKEN=your-square-production-access-token
SQUARE_LOCATION_ID=your-square-location-id
SQUARE_ENVIRONMENT=production
SQUARE_WEBHOOK_SIGNATURE_KEY=your-square-webhook-signature-key
SQUARE_WEBHOOK_NOTIFICATION_URL=https://your-owner-hub-domain.example/api/square-webhook

# Subscription billing for Owner Hub customers (platform Square account)
SQUARE_BILLING_ACCESS_TOKEN=your-platform-square-access-token
SQUARE_BILLING_LOCATION_ID=your-platform-square-location-id
SQUARE_SUBSCRIPTION_PLAN_STARTER=your-square-starter-plan-variation-id
SQUARE_SUBSCRIPTION_PLAN_PRO=your-square-pro-plan-variation-id
SQUARE_SUBSCRIPTION_PLAN_TEAM=your-square-team-plan-variation-id

# Square OAuth so each contractor connects their own merchant account
SQUARE_APPLICATION_ID=your-square-application-id
SQUARE_APPLICATION_SECRET=your-square-application-secret
SQUARE_OAUTH_REDIRECT_URI=https://your-owner-hub-domain.example/api/square-oauth-callback
SQUARE_TOKEN_ENCRYPTION_KEY=use-at-least-32-random-characters
OWNER_HUB_PUBLIC_URL=https://your-owner-hub-domain.example

# Optional but recommended for secure Customer Hub Supabase Realtime tokens.
# Server-only: copy the project's legacy JWT secret from Supabase API settings.
SUPABASE_JWT_SECRET=your-server-only-supabase-jwt-secret

# Content Autopilot rollout flags. Keep live provider publishing off until each
# connection passes its in-app Test Connection check.
CONTENT_AUTOPILOT_ENABLED=true
AI_CONTENT_GENERATION_ENABLED=true
FACEBOOK_PUBLISHING_ENABLED=false
GBP_PUBLISHING_ENABLED=false
YOUTUBE_PUBLISHING_ENABLED=false
AUTOPILOT_LEVEL4_ENABLED=false
CONTENT_PROVIDER_MOCK_MODE=true

# Content Autopilot encryption, worker, and private-bucket configuration.
# Never prefix credentials or encryption keys with VITE_. The bucket name is
# intentionally mirrored to the browser because it is not a secret.
CONTENT_TOKEN_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64-secret
CONTENT_WORKER_SECRET=replace-with-a-long-random-worker-secret
CRON_SECRET=replace-with-the-vercel-cron-secret
CONTENT_VIDEO_BUCKET=content-videos
VITE_CONTENT_VIDEO_BUCKET=content-videos
OPENAI_CONTENT_MODEL=gpt-5.4-mini

# Meta OAuth and Facebook Page publishing. Set the current Graph API version
# shown for your app in the Meta developer dashboard.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=https://your-owner-hub-domain.example/api/content-autopilot-oauth-callback
META_GRAPH_API_VERSION=vXX.X

# Google OAuth shared by Google Business Profile and YouTube.
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-web-client-secret
GOOGLE_REDIRECT_URI=https://your-owner-hub-domain.example/api/content-autopilot-oauth-callback
