# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only secret. Never prefix this variable with VITE_.
OPENAI_API_KEY=your-openai-project-api-key

# Optional server settings
OPENAI_ESTIMATE_MODEL=gpt-5.6-sol
OWNER_HUB_ALLOWED_ORIGINS=https://your-owner-hub-domain.example

# Required when the Android bundle calls a separately hosted Owner Hub API.
VITE_OWNER_HUB_API_URL=https://your-owner-hub-domain.example
